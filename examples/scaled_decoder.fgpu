# Explicit scaled single-head decoder; bf16 score/probability boundaries remain.
# Not a full LLaMA model; no causal mask, GQA or KV cache.
pipeline scaled_decoder {
    input x        : bf16[B,D]
    input norm1_w  : bf16[D]
    input w_q      : bf16[D,D]
    input w_k      : bf16[D,D]
    input w_v      : bf16[D,D]
    input w_o      : bf16[D,D]
    input norm2_w  : bf16[D]
    input w_gate   : bf16[D,H]
    input w_up     : bf16[D,H]
    input w_down   : bf16[H,D]

    input attention_scale : bf16[B,B]
    # Caller fills attention_scale with 1/sqrt(D).
    # Attention sub-block

    input rope_cos : bf16[B,D]
    input rope_sin : bf16[B,D]
    x_norm1 = rms_norm(x, norm1_w)
    q = matmul(x_norm1, w_q)
    k = matmul(x_norm1, w_k)
    v = matmul(x_norm1, w_v)
    q_rope = rope(q, rope_cos, rope_sin)
    k_rope = rope(k, rope_cos, rope_sin)
    k_t = transpose(k_rope)
    scores = matmul(q_rope, k_t)
    scaled_scores = mul(scores, attention_scale)
    probs = softmax(scaled_scores)
    attn_out = matmul(probs, v)
    attn_proj = matmul(attn_out, w_o)
    x_mid = add(x, attn_proj)

    # MLP sub-block (SwiGLU)
    x_norm2 = rms_norm(x_mid, norm2_w)
    gate = matmul(x_norm2, w_gate)
    up = matmul(x_norm2, w_up)
    gate_act = silu(gate)
    hidden = mul(gate_act, up)
    mlp_out = matmul(hidden, w_down)
    out = add(x_mid, mlp_out)

    output out
}
