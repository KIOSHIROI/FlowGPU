# Design.md Phase 2: Simplified single-head decoder block
#
# Demonstrates decoder-style dataflow; this is not a full LLaMA-3 model.
# No head split, GQA, KV cache, causal mask, or 1/sqrt(D) score scaling.
# The caller supplies full-shape RoPE tables for the chosen positions and theta.
# Includes:
# 1. Attention Pre-RMSNorm
# 2. QKV Linear Projections
# 3. Rotary Position Embedding (RoPE)
# 4. Unscaled Single-Head Dot-Product Attention:
#    - Q @ K^T -> Attention Scores
#    - Softmax(Scores) -> Attention Probabilities
#    - Probabilities @ V -> Context
# 5. Output Projection
# 6. Residual Connection (x + Output)
# 7. Feed-Forward Pre-RMSNorm
# 8. Gated MLP Block:
#    - Gate Projection: x @ w_gate
#    - Up Projection: x @ w_up
#    - SiLU(Gate) * Up (SwiGLU activation)
#    - Down Projection: Hidden @ w_down
# 9. Second Residual Connection (x_mid + MLP_out)

pipeline llama3_decoder_layer {
    input x        : bf16[B,D]
    input norm1_w  : bf16[D]
    input w_q      : bf16[D,D]
    input w_k      : bf16[D,D]
    input w_v      : bf16[D,D]
    input w_o      : bf16[D,D]
    input norm2_w  : bf16[D]
    input w_gate   : bf16[D,H]
    input w_up     : bf16[D,H]
    input w_down   : bf16[H,D]

    # Attention sub-block

    input rope_cos : bf16[B,D]
    input rope_sin : bf16[B,D]
    x_norm1 = rms_norm(x, norm1_w)
    q = matmul(x_norm1, w_q)
    k = matmul(x_norm1, w_k)
    v = matmul(x_norm1, w_v)
    q_rope = rope(q, rope_cos, rope_sin)
    k_rope = rope(k, rope_cos, rope_sin)
    k_t = transpose(k_rope)
    scores = matmul(q_rope, k_t)
    probs = softmax(scores)
    attn_out = matmul(probs, v)
    attn_proj = matmul(attn_out, w_o)
    x_mid = add(x, attn_proj)

    # MLP sub-block (SwiGLU)
    x_norm2 = rms_norm(x_mid, norm2_w)
    gate = matmul(x_norm2, w_gate)
    up = matmul(x_norm2, w_up)
    gate_act = silu(gate)
    hidden = mul(gate_act, up)
    mlp_out = matmul(hidden, w_down)
    out = add(x_mid, mlp_out)

    output out
}
